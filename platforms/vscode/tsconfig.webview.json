{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/vscodeAdapter.ts",
    "src/vscodeServices.ts",
    "webview/main.tsx",
    "../../src/**/*.ts",
    "../../src/**/*.tsx"
  ],
  "exclude": [
    "../../src/**/*.test.ts",
    "../../src/**/*.spec.ts"
  ]
}
